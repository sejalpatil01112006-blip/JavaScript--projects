function setup() {
  createCanvas(400, 400);
}

function draw() {
  background(0, 20);
  noStroke();
  fill(73,157, 208, 20);
  circle(mouseX, mouseY, 80);
  
  fill(73,157, 208, 40);
  circle (mouseX, mouseY, 70);
  
  fill(73,157, 208, 80);
  circle (mouseX, mouseY, 60);
  
  fill(73,157, 208, 100);
  circle (mouseX, mouseY, 50);
  
  fill(255, 255, 255)
  circle(mouseX + random(-50, 50), mouseY + random(-50, 50), 3);
}
